---
import { Image } from "astro:assets";
import { images } from "../../lib/images";
interface Props {
  src: string;
  alt: string;
  sizes?: string;
}
const { src, alt, sizes = "(max-width: 640px) 50vw, 240px" } = Astro.props;
const image = images[src];
if (!image) throw new Error(`Missing image: ${src}`);
const wide = src.includes("/gallery/");
const widths = [
  ...new Set([
    Math.min(wide ? 480 : 160, image.width),
    Math.min(wide ? 1200 : 480, image.width),
  ]),
];
---

{image.format === "svg" ? (
  <Image src={image} alt={alt} loading="lazy" />
) : (
  <Image
    src={image}
    alt={alt}
    widths={widths}
    width={widths.at(-1)}
    sizes={sizes}
    format="webp"
    quality={78}
    loading="lazy"
    decoding="async"
  />
)}
